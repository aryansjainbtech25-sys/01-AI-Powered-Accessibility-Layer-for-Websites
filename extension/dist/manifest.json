{
  "manifest_version": 3,
  "name": "StudyLens",
  "version": "1.0.0",
  "description": "AI-powered accessibility assistant for NCERT",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}